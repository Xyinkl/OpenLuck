# Static cache policy for Cloudflare Pages.
# _headers matches the URL path and ignores the query string.
# JS below is referenced with ?v=20261114-perf1. Bump that query on every
# change to i18n.js or analytics.js, or a year-long immutable cache will
# keep serving the previous file to browsers that still have the old URL
# bookmarked — and, more importantly, new deploys will not reach visitors
# who cached the old URL. There is no separate CSS file; do not add a
# blanket CSS rule until those files are versioned the same way.

/i18n.js
  Cache-Control: public, max-age=31536000, immutable

/analytics.js
  Cache-Control: public, max-age=31536000, immutable

# HTML changes with deploys, so keep the fresh window short and let the
# browser reuse a stale copy while it revalidates.
/
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/index.html
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/history
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/history.html
  Cache-Control: public, max-age=60, stale-while-revalidate=300
